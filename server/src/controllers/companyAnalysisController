const prisma =
  require("../config/prisma");

const {
  analyzeDreamCompany
} = require(
  "../services/companyAnalysisService"
);

const analyzeCompany =
async (req, res) => {

  try {

    const {
      resumeId,
      company,
      role
    } = req.body;

    const resume =
      await prisma.resume.findUnique({
        where: {
          id: resumeId
        }
      });

    if (!resume) {

      return res.status(404)
        .json({
          success: false,
          message:
            "Resume not found"
        });

    }

    const analysisResult =
      await analyzeDreamCompany(
        resume.extractedText,
        company,
        role
      );

    const analysis =
      await prisma.companyAnalysis.create({
        data: {
          company,
          role,
          resumeId,
          result: analysisResult
        }
      });

    res.json({
      success: true,
      analysis
    });

  } catch (error) {

    console.error(error);

    res.status(500).json({
      success: false,
      message:
        "Failed to analyze company"
    });

  }

};

module.exports = {
  analyzeCompany
};